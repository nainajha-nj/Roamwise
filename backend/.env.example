# Optional Gemini AI (leave blank to use local fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Supabase persistence; SQLite is used if either value is blank
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins. Vite dev server is included by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=roamwise.db
